  "forecast_drivers": {
    "token_demand": {
      "driver": "burst_tokens_total_daily",
      "evidence_type": "forecast",
      "covered_months": 1,
      "extrapolated_months": 11,
      "used_fallback": false,
      "note": "demand factor = 30-day run-rate / median simulated run-rate (relative variation only)"
    },
    "wages": {
      "driver": "eci_wages_quarterly",
      "evidence_type": "forecast",
      "covered_months": 12,
      "extrapolated_months": 0,
      "used_fallback": false,
      "note": "ECI(m)/ECI(0), ECI(0) = 178.145 (last observed); monthly by linear interpolation"
    },
    "hosting": {
      "driver": "ppi_hosting_monthly",
      "evidence_type": "forecast",
      "covered_months": 12,
      "extrapolated_months": 0,
      "used_fallback": false,
      "note": "PPI(m)/PPI(0), PPI(0) = 126.911 (last observed)"
    },
    "token_price": {
      "driver": "fixed_token_price_per_mtok",
      "evidence_type": "estimate",
      "covered_months": 12,
      "extrapolated_months": 0,
      "used_fallback": true,
      "note": "no Epoch price forecast: flat fixed_token_price_per_mtok from the inputs (an estimate)"
    }
  },
  "scenarios": {
    "downside": {
      "parameter": "task_time_change_with_ai",
      "raw": 18.8,
      "unit": "pct_change_in_task_time",
      "conversion": "-(18.8% / 100) x ai_assisted_share_of_hours 0.25 = -0.04700",
      "time_saved_fraction": -0.047
    },
    "expected": {
      "parameter": "time_saved_share_of_work_hours",
      "raw": 2.084485382,
      "unit": "pct_of_work_hours",
