# Optional settings for the dashboard. None are required: the site runs with no environment variables at all.
# Copy to .env (never commit real values) or set them in the host's dashboard (Render: Environment).

# Folder that holds data/, outputs/ and artifacts/ (default: the repository root).
# TSAF_DASH_ROOT=/path/to/ai-workforce-intel

# Set to "off" to never show the first-visit tour (the address ?tour=off does the same for one visit).
# AIWI_TOUR=off

# Tests only: page errors raise instead of showing the friendly error card. Leave unset on the live site.
# AIWI_STRICT=1
